<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; background: #f4f7f9; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 20px auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 24px; text-align: center; }
    .header h1 { margin: 0; font-size: 22px; }
    .header p { margin: 8px 0 0; opacity: 0.9; font-size: 14px; }
    .body { padding: 24px; }
    .greeting { font-size: 16px; color: #333; margin-bottom: 16px; }
    .property-card { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    .property-name { font-size: 15px; font-weight: bold; color: #1f2937; margin-bottom: 8px; }
    .prop-detail { font-size: 13px; color: #6b7280; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-left: 8px; }
    .badge.superavit { background: #d1fae5; color: #065f46; }
    .badge.deficit { background: #fee2e2; color: #991b1b; }
    .badge.equilibrio { background: #fef3c7; color: #92400e; }
    .stats-grid { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
    .stat-item { flex: 1; min-width: 100px; background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 10px; text-align: center; }
    .stat-value { font-size: 18px; font-weight: bold; color: #111827; }
    .stat-label { font-size: 11px; color: #9ca3af; margin-top: 2px; }
    .insight { background: #eff6ff; border-left: 4px solid #3b82f6; padding: 12px; margin-top: 12px; border-radius: 0 6px 6px 0; font-size: 13px; color: #1e40af; }
    .savings { background: #ecfdf5; border-left: 4px solid #10b981; padding: 12px; margin-top: 8px; border-radius: 0 6px 6px 0; font-size: 13px; color: #065f46; }
    .footer { background: #f9fafb; padding: 16px 24px; text-align: center; font-size: 12px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
    .btn { display: inline-block; background: #f59e0b; color: white; text-decoration: none; padding: 10px 24px; border-radius: 6px; font-weight: bold; margin-top: 16px; font-size: 14px; }
    hr { border: none; border-top: 1px solid #e5e7eb; margin: 16px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>☀️ Relatório Diário Solaris Potiguar</h1>
      <p><%= @date %></p>
    </div>
    <div class="body">
      <p class="greeting">Olá <strong><%= @user.full_name %></strong>,</p>
      <p style="color:#6b7280;font-size:14px;margin-bottom:20px;">
        Aqui está o resumo de hoje com as condições e recomendações para suas propriedades.
      </p>

      <% @analyses.each do |entry| %>
        <% property = entry[:property] %>
        <% analysis = entry[:analysis] %>
        <div class="property-card">
          <div class="property-name">
            🌿 <%= property.farm_name %>
            <span class="badge <%= classification_class(analysis) %>"><%= classification_label(analysis) %></span>
          </div>
          <div class="prop-detail"><%= property.city %></div>

          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-value"><%= number_with_precision(analysis.estimated_generation_kwh, precision: 1) %></div>
              <div class="stat-label">Geração (kWh)</div>
            </div>
            <div class="stat-item">
              <div class="stat-value"><%= number_with_precision(analysis.estimated_consumption_kwh, precision: 1) %></div>
              <div class="stat-label">Consumo (kWh)</div>
            </div>
            <div class="stat-item">
              <div class="stat-value"><%= number_with_precision(analysis.balance_kwh, precision: 1) %></div>
              <div class="stat-label">Saldo (kWh)</div>
            </div>
            <div class="stat-item">
              <div class="stat-value"><%= number_to_currency(analysis.estimated_savings_currency, unit: "R$", precision: 2) %></div>
              <div class="stat-label">Economia</div>
            </div>
          </div>

          <% if analysis.executive_summary.present? %>
            <div class="insight">💡 <%= analysis.executive_summary %></div>
          <% end %>

          <% if analysis.estimated_savings_currency.to_f > 0 %>
            <div class="savings">💰 Economia estimada: <strong><%= number_to_currency(analysis.estimated_savings_currency, unit: "R$", precision: 2) %></strong></div>
          <% end %>
        </div>
      <% end %>

      <div style="text-align:center;">
        <a href="http://localhost/dashboard" class="btn">Ver Detalhes no Dashboard</a>
      </div>

      <hr>
      <p style="font-size:12px;color:#9ca3af;text-align:center;">
        Este é um relatório automático gerado pelo Solaris Potiguar.<br>
        Em caso de dúvidas, responda a este e-mail.
      </p>
    </div>
    <div class="footer">
      Solaris Potiguar — Energia inteligente para o Nordeste 🌞
    </div>
  </div>
</body>
</html>
