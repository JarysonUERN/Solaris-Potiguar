# Chave mestra do Rails (conteúdo de BackEnd/config/master.key)
RAILS_MASTER_KEY=

# Chave da API Fireworks AI
FIREWORKS_API_KEY=

# ─── Configuração de E-mail (SMTP) ───────────────────────────
# Usado pelo Rails Action Mailer e pelo n8n para envio de e-mails
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true
SMTP_OPENSSL_VERIFY=peer

# Remetente padrão para e-mails do n8n
N8N_SMTP_SENDER=noreply@solarispotiguar.com

# ─── API Key para automação diária (n8n → Rails) ────────────
# Gere uma chave segura com: openssl rand -hex 32
DAILY_ANALYSIS_API_KEY=

# ─── Configuração do n8n ─────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
# Chave de API para acessar a REST API do n8n (opcional)
N8N_API_KEY=

# ─── Configuração do Host (para links nos e-mails) ──────────
HOST=localhost
